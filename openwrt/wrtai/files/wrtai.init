#!/bin/sh /etc/rc.common
# WRT AI procd init script

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load wrtai
	config_get enabled main enabled "0"
	[ "$enabled" = "1" ] || return 0

	local port
	config_get port main port "8765"

	procd_open_instance
	procd_set_param command /usr/bin/wrtai -data /etc/wrtai -port "$port"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/wrtai
	procd_close_instance
}

reload_service() {
	stop
	start
}
